<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="https://dtp-lab.github.io<%= canonicalPath %>">
  <% if (typeof verificationToken !== 'undefined' && verificationToken) { -%>
  <meta name="google-site-verification" content="<%= verificationToken %>">
  <% } -%>
  <% if (typeof noindex !== 'undefined' && noindex) { -%>
  <meta name="robots" content="noindex,nofollow">
  <% } -%>
  <title><%= title %></title>
  <% if (typeof structuredData !== 'undefined' && structuredData) { -%>
  <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } -%>
  <link rel="icon" type="image/png" href="/assets/brand/dtp-logo-icon.png">
  <link rel="stylesheet" href="/styles.css?v=31">
  <script src="/shared.js?v=31" defer></script>
  <% for (const script of scripts || []) { -%>
  <script src="/<%= script %>?v=31" defer></script>
  <% } -%>
</head>
<body data-page="<%= pageKey %>">
